# SMTP — required for contact form (Netlify / Vercel env vars in production)
#
# Brevo:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your_smtp_login_from_brevo_dashboard
#   SMTP_PASS=your_smtp_key_not_api_key
#   SMTP_FROM=systems.roncal@gmail.com  (must be a verified sender in Brevo)
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=systems.roncal@gmail.com
#   SMTP_PASS=your_gmail_app_password

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_from_brevo_dashboard
SMTP_PASS=your_smtp_key_here
SMTP_FROM=systems.roncal@gmail.com

# Optional: override API URL (defaults to /api/contact)
# VITE_CONTACT_API_URL=/api/contact
