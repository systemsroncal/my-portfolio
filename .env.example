# SMTP — required for /api/contact (Vercel env vars in production)
# Gmail: enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=systems.roncal@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional: override API URL (defaults to /api/contact)
# VITE_CONTACT_API_URL=/api/contact
